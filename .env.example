# Ask Robert uses the local portfolio knowledge engine by default.
# Set this to true only after adding a server-side provider key.
AI_PORTFOLIO_ENABLED=false

# Optional: enables the Groq RAG path in /api/ask-robert.
# Keep this secret server-side only. Do not expose it with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
